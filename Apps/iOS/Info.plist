<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>InsightsEnabled</key>
	<string>$(INSIGHTS_ENABLED)</string>
	<key>SchedulesEnabled</key>
	<string>$(SCHEDULES_ENABLED)</string>
	<key>GoogleSignInEnabled</key>
	<string>$(GOOGLE_SIGN_IN_ENABLED)</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.somalabs.flight.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>somaflight</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Soma Flight uses the camera to scan the barcode on your boarding pass, and to take your profile photo if you choose to. A pass picture stays on your device; a profile photo is shown only to friends you accept.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Boarding Pass</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.pkpass</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.apple.pkpass</string>
			<key>UTTypeDescription</key>
			<string>Wallet Pass</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.pkware.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pkpass</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.apple.pkpass</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
