// Release builds have no default backend: SUPABASE_URL and SUPABASE_ANON_KEY must come from
// Config.local.xcconfig next to this file (git ignores it). Left empty, the app refuses to start and
// says it has no server configured (SupabaseConfig.fromBundle). Release also refuses a plain http URL
// and does not allow local networking.
// Anon key only, never the service role key. Write the URL's slashes as `/$()/`.
SUPABASE_URL =
SUPABASE_ANON_KEY =

// The flight sheet's arrival forecast, inbound plane and alternate flights (edge functions flight-insights
// and alternate-flights, paid AeroAPI calls on the backend, cached and under the daily spend cap). On since
// the owner's yes (2026-11-06). Until AEROAPI_KEY is set on the backend they answer provider_unavailable
// and the sections say so. NO hides them and makes no call.
INSIGHTS_ENABLED = YES

// The search's days ahead (edge function flight-schedules, paid AeroAPI schedules). NO in both until
// the function is deployed: Debug builds then search fake schedules, Release builds say future dates
// need the live service. YES asks flight-schedules.
SCHEDULES_ENABLED = NO

// Language-model texts (edge function flight-brief: door-to-door guide, delay causes, airport summaries),
// Azure OpenAI calls on the backend. NO until the owner's yes on the cost: the sections stay hidden and
// no call is made. YES asks flight-brief, which answers llm_unavailable while LLM_ENABLED is off there.
LLM_ENABLED = NO

// The nearby radar (edge function nearby-flights, paid AeroAPI area search). NO until the owner's yes
// and AEROAPI_KEY: the radar entry stays hidden and no call is made.
RADAR_ENABLED = NO

#include? "Config.local.xcconfig"

// Sign in with Google (docs/profile-onboarding.md). NO until the owner turns the provider on in Supabase.
GOOGLE_SIGN_IN_ENABLED = NO
