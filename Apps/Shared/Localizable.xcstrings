        }
      }
    },
    "This file is empty.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est vide."
          }
        }
      }
    },
    "This file is larger than 10 MB. Split it and import each part.": {
      "localizations": {
