    "Texts are not available yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les SMS ne sont pas encore disponibles."
          }
        }
      }
    },
    "Texts stop and the number is deleted from your account. To get texts again, you verify it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les SMS s'arrêtent et le numéro est effacé de ton compte. Pour en recevoir à nouveau, tu devras le vérifier une nouvelle fois."
          }
        }
      }
    },
    "That Wallet pass is not a boarding pass.": {
      "localizations": {
