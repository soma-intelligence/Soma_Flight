            "state": "translated",
            "value": "Ce fichier n'a pas pu être lu, ou dépasse 12 Mo."
          }
        }
      }
    },
    "This file couldn't be opened. If it's in iCloud Drive, open it once in Files so it downloads, then pick it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
